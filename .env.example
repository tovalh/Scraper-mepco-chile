# Cada nombre de MEPCO_DBS lee sus variables desde DB_<NOMBRE>_*

MEPCO_DBS=prod

DB_PROD_DSN=usuario:password@tcp(localhost:3306)/nombre_base?charset=utf8mb4&timeout=10s
DB_PROD_USER=cron_mepco

# MEPCO_DBS=prod,cliente_a
# DB_CLIENTE_A_DSN=usuario:password@tcp(10.0.0.5:3306)/base_cliente_a?charset=utf8mb4&timeout=10s
# DB_CLIENTE_A_USER=cron_mepco

# Por defecto busca el .env junto al binario y despues en el directorio actual.
# MEPCO_ENV=/etc/mepco/.env
